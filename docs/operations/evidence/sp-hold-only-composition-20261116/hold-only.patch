+#[cfg(test)]
+mod sp_writedown_hold_tests {
+    use super::{
+        decode_state_body, resolve_sp_writedown_hold, set_sp_writedown_hold,
+        sp_writedown_hold, StableCell, MEMORY_MANAGER, SP_WRITEDOWN_HOLD_MEMORY_ID,

+fn redemption_transfer_meets_minimum(
+    gross_raw: u64,
+    fee_raw: u64,
+    minimum_net_raw: Option<u64>,
+) -> bool {
+    minimum_net_raw
+        .map(|minimum| {
+            let net = gross_raw.saturating_sub(fee_raw);
+            net > 0 && net >= minimum
+        })
+        .unwrap_or(true)
+}
 

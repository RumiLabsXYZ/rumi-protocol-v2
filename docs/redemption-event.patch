+#[cfg(test)]
+mod redemption_event_contract_tests {
+    use super::*;
+
+    fn init_event() -> Event {
+        Event::Init(InitArg {
+            xrc_principal: Principal::anonymous(), icusd_ledger_principal: Principal::anonymous(),
+            icp_ledger_principal: Principal::anonymous(), fee_e8s: 0,
+            developer_principal: Principal::anonymous(), treasury_principal: None,
+            stability_pool_principal: None, ckusdt_ledger_principal: None,
+            ckusdc_ledger_principal: None,
+        })
+    }
+
+    fn redemption_event(vault_redemptions: Option<Vec<VaultRedemption>>, payout: Option<u64>, minimum: Option<u64>) -> Event {
+        Event::RedemptionOnVaults {
+            owner: Principal::anonymous(), current_icp_rate: UsdIcp::from(Decimal::from(5u8)),
+            icusd_amount: ICUSD::new(100_000_000), fee_amount: ICUSD::new(0),
+            icusd_block_index: 7, collateral_type: Some(Principal::anonymous()),
+            timestamp: Some(1), vault_redemptions, payout_collateral_raw: payout,
+            min_net_collateral_raw: minimum,
+        }
+    }
+
+    #[test]
+    fn payout_uses_native_raw_units_for_six_eight_and_eighteen_decimal_assets() {
+        for (raw, expected) in [
+            (1_250_000u64, 1_250_000u64),
+            (125_000_000u64, 125_000_000u64),
+            (1_250_000_000_000_000_000u64, 1_250_000_000_000_000_000u64),
+        ] {
+            let outcome = [VaultRedemption { vault_id: 1, icusd_redeemed_e8s: 1, collateral_seized: raw }];
+            assert_eq!(total_actual_collateral_seized(&outcome), expected);
+        }
+    }
+
+    #[test]
+    fn payout_uses_actual_saturated_and_rounded_seized_sum() {
+        let outcomes = [
+            VaultRedemption { vault_id: 1, icusd_redeemed_e8s: 100, collateral_seized: 80 },
+            VaultRedemption { vault_id: 2, icusd_redeemed_e8s: 1, collateral_seized: 7 },
+        ];
+        assert_eq!(total_actual_collateral_seized(&outcomes), 87);
+        let overflow = [
+            VaultRedemption { vault_id: 3, icusd_redeemed_e8s: 1, collateral_seized: u64::MAX },
+            VaultRedemption { vault_id: 4, icusd_redeemed_e8s: 1, collateral_seized: 1 },
+        ];
+        assert_eq!(total_actual_collateral_seized(&overflow), u64::MAX);
+    }
+
+    #[test]
+    fn new_event_round_trip_preserves_payout_and_minimum() {
+        let event = redemption_event(Some(Vec::new()), Some(1_250_000), Some(1_200_000));
+        let encoded = serde_json::to_vec(&event).unwrap();
+        let decoded: Event = serde_json::from_slice(&encoded).unwrap();
+        assert_eq!(decoded, event);
+    }
+
+    #[test]
+    fn old_event_fields_default_and_old_pending_claim_replay_is_preserved() {
+        let event = redemption_event(Some(vec![VaultRedemption {
+            vault_id: 999, icusd_redeemed_e8s: 100_000_000, collateral_seized: 80_000,
+        }]), Some(80_000), Some(70_000));
+        let mut json = serde_json::to_value(event).unwrap();
+        let payload = json.as_object_mut().and_then(|outer| outer.values_mut().next())
+            .and_then(serde_json::Value::as_object_mut).unwrap();
+        payload.remove("payout_collateral_raw");
+        payload.remove("min_net_collateral_raw");
+        let legacy: Event = serde_json::from_value(json).unwrap();
+        let replayed = replay(vec![init_event(), legacy].into_iter()).unwrap();
+        let pending = replayed.pending_redemption_transfer.get(&7).unwrap();
+        assert_eq!(pending.margin.to_u64(), 20_000_000);
+        assert_eq!(pending.min_net_collateral_raw, None);
+    }
+
+    #[test]
+    fn new_event_replay_restores_exact_payout_and_minimum() {
+        let event = redemption_event(Some(vec![VaultRedemption {
+            vault_id: 999, icusd_redeemed_e8s: 100_000_000, collateral_seized: 80_000,
+        }]), Some(80_000), Some(70_000));
+        let replayed = replay(vec![init_event(), event].into_iter()).unwrap();
+        let pending = replayed.pending_redemption_transfer.get(&7).unwrap();
+        assert_eq!(pending.margin.to_u64(), 80_000);
+        assert_eq!(pending.min_net_collateral_raw, Some(70_000));
+    }
+}

{
  "name": "conflux_espace_frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Standalone injected-wallet UI for the Rumi EVM-native CDP rail. Defaults to Conflux eSpace testnet; includes an explicit local production-canary build.",
  "scripts": {
    "dev": "vite",
    "dev:production-canary": "VITE_DEPLOYMENT_MODE=production-canary vite",
    "build": "vite build",
    "build:testnet": "VITE_DEPLOYMENT_MODE=testnet vite build",
    "build:production-canary": "VITE_DEPLOYMENT_MODE=production-canary vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:production-canary": "VITE_DEPLOYMENT_MODE=production-canary vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@tsconfig/svelte": "^5.0.4",
    "svelte": "^5.22.6",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@dfinity/agent": "^2.3.0",
    "@dfinity/candid": "^2.3.0",
    "@dfinity/principal": "^2.3.0",
    "viem": "^2.22.0"
  }
}

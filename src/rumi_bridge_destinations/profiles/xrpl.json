      "source_kind": "repo"
    }
  },
  "prerequisites": [
    {
      "value": {
        "id": "issuer-funding",
        "text": "The issuer account must be funded from outside: 1 XRP base reserve plus 0.2 XRP per owned object.",
        "unavoidable": true
      },
      "source_url": "https://xrpl.org/docs/concepts/accounts/reserves",
      "verified": "2026-10-30",
      "source_kind": "primary"
    },
    {
      "value": {
        "id": "holder-trust-line",
        "text": "Holders must create a trust line to the issuer before they can receive icUSD.",
        "unavoidable": true
      },
      "source_url": "https://xrpl.org/docs/concepts/tokens/fungible-tokens/trust-line-tokens",
      "verified": "2026-10-30",
      "source_kind": "primary"
    }
  ],
  "open_decisions": [
    {
      "id": "D2",
      "topic": "XRPL trust-line token (PR #586) or Multi-Purpose Token",
      "choice": {
        "value": "issued_currency_lane_mpt_deferred",
        "rationale": "Design section 12 (settled for planning): XRPL uses PR #586's issued-currency escrow and import seam; MPT is deferred, not a replacement gate; the no-vault canonical return stays a named missing implementation.",
        "status": "planning_decision"
      }
    },
    {
      "id": "D7",
      "topic": "XRPL precision caps: 15 versus 16 digits",
      "choice": {
        "value": "15_digit_caps_per_operation_and_total_outstanding",
        "rationale": "Design section 12 (settled for planning): conservative 15-significant-digit caps (999999999999999 e8s) on each operation AND on total outstanding, with exact rejection or holding of inexact amounts.",
        "status": "planning_decision"
      }
    },
    {
      "id": "D9",
      "topic": "Testnet escrow: real icUSD ledger or a test ledger",
      "choice": {
        "value": "synthetic_test_ledgers",
        "rationale": "Design section 12 (settled for planning): synthetic test ledgers for future testnet demos; no real canonical icUSD is locked for a new testnet rollout under this groundwork.",
        "status": "planning_decision"
      }
    }
  ],

{
  "schema_version": 1,
  "id": "xrpl",
  "display_name": "XRP Ledger",
  "family": "xrpl",
  "topology": {
    "kind": {
      "value": "backend_module",
      "rationale": "PR #586 already is a backend module with one XRPL icUSD lane; no XRPL bridge instance and no second XRPL token (design section 1.4).",
      "status": "recommendation"
    },
    "wasm_family": null,
    "existing_work": {
      "value": "pr586",
      "source_url": "docs/coordination/multichain/xrpl-pr586-inventory.md",
      "verified": "2026-10-30",
      "source_kind": "repo"
    }
  },
  "representation": {
    "standard": {
      "value": "xrpl_iou",
      "rationale": "PR #586 implements an escrow-backed trust-line issued currency with exact decimal parsing and caps. D2 (settled for planning) keeps that lane; Multi-Purpose Token is deferred, not a replacement gate.",
      "status": "planning_decision"
    },
    "backing": "escrow_locked_icusd",
    "debt_creating": false,
    "decimals": 8,
    "amount_bounds": {
      "value": {
        "min_e8s": "1",
        "max_e8s": "999999999999999",
        "max_outstanding_e8s": "999999999999999",
        "encoding": "xrpl_decimal_15"
      },
      "source_url": "https://xrpl.org/docs/references/protocol/data-types/currency-formats",
      "verified": "2026-10-30",
      "source_kind": "derived"
    }
  },
  "signing": {
    "scheme": "schnorr_ed25519",
    "key_name": {
      "value": {
        "mainnet": "key_1",
        "testnet": "test_key_1"
      },
      "source_url": "https://docs.internetcomputer.org/concepts/chain-key-cryptography.md",
      "verified": "2026-10-30",
      "source_kind": "primary"
    },
    "derivation_domain": [
      "rumi",
      "xrpl-icusd",
      "v1",
      "{network_identity}"
    ],
    "domains": {
      "mint_id": null,
      "remint_id": null,
      "return_id": null,
      "escrow_label": "rumi:xrpl-icusd:escrow:v1"
    },
    "signed_payload": {
      "value": "Ed25519 over the 0x53545800 prefix followed by the canonical serialization without TxnSignature; no pre-hash.",
      "source_url": "https://xrpl.org/docs/references/protocol/binary-format",
      "verified": "2026-10-30",
      "source_kind": "primary"
    }
  },
  "wallet": {
    "standard": "vendor_specific",
    "named": {
      "value": [
        "Xaman"
      ],
      "source_url": "docs/coordination/multichain/xrpl-pr586-inventory.md",

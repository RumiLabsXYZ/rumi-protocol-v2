// ──────────────────────────────────────────────────────────────
// Rumi Stability Pool — Multi-Token Candid Interface
// ──────────────────────────────────────────────────────────────

// Init args
type StabilityPoolInitArgs = record {
  protocol_canister_id : principal;
  authorized_admins : vec principal;
};

// ── Registry types ──

type StablecoinConfig = record {
  ledger_id : principal;
  symbol : text;
  decimals : nat8;
  priority : nat8;
  is_active : bool;
  transfer_fee : opt nat64;
  is_lp_token : opt bool;
  underlying_pool : opt principal;
};

type CollateralInfo = record {
  ledger_id : principal;
  symbol : text;
  decimals : nat8;
  status : CollateralStatus;
};

type LedgerReconciliationEntry = record {
  ledger : principal;
  symbol : text;
  recorded_e8s : nat64;
  live_e8s : nat64;
  delta_e8s : int64;
  healthy : bool;
};

type InterestMintReceiptCapacity = record {
  retained : opt nat64;
  legacy_unknown : opt nat64;
  capacity : nat64;
  warning_threshold : nat64;
  warning : bool;
  accepts_new : bool;
  admission_blocked_reason : opt text;
  legacy_floor : opt nat64;
};

type CollateralStatus = variant {
  Active;
  Paused;
  Frozen;
  Sunset;
  Deprecated;
};

// ── Configuration ──

type PoolConfiguration = record {
  min_deposit_e8s : nat64;
  max_liquidations_per_batch : nat64;
  emergency_pause : bool;
  authorized_admins : vec principal;
};

type CycleManagerCyclesStatus = record {
  balance : nat;
  low_watermark : nat;
  healthy : bool;
  freeze_threshold_secs : nat64;
  stable_memory_bytes : opt nat64;
  heap_memory_bytes : opt nat64;
  idle_burn_cycles_per_day : opt nat;
};
type CycleManagerMetric = record {
  key : text;
  count : nat64;
  value : nat;
  label : opt text;
};

// ── Pool status / user position ──

type StabilityPoolStatus = record {
  total_deposits_e8s : nat64;
  total_depositors : nat64;
  total_liquidations_executed : nat64;
  stablecoin_balances : vec record { principal; nat64 };
  collateral_gains : vec record { principal; nat64 };
  stablecoin_registry : vec StablecoinConfig;
  collateral_registry : vec CollateralInfo;
  emergency_paused : bool;
  total_interest_received_e8s : nat64;
  eligible_icusd_per_collateral : vec record { principal; nat64 };
  eligible_usd_per_collateral : opt vec record { principal; nat64 };
};

type UserStabilityPosition = record {
  stablecoin_balances : vec record { principal; nat64 };
  collateral_gains : vec record { principal; nat64 };
  cfx_claims : opt vec record { principal; nat };
  opted_out_collateral : vec principal;
  eligible_interest_collateral : opt vec principal;
  native_payout_addresses : opt vec record { principal; text };
  native_payout_destination_tags : opt vec record { principal; nat32 };
  deposit_timestamp : nat64;
  total_claimed_gains : vec record { principal; nat64 };
  total_usd_value_e8s : nat64;
  total_interest_earned_e8s : nat64;
};

type NativeXrpPendingPayout = record {
  claim_id : nat64;
  collateral_type : principal;
  vault_id : nat64;
  drops : nat64;
  payout_address : text;
  destination_tag : opt nat32;
  created_at_ns : nat64;
};

// ── Liquidation types ──

type LiquidatableVaultInfo = record {
  vault_id : nat64;
  collateral_type : principal;
  debt_amount : nat64;
  collateral_amount : nat64;
};

type LiquidationResult = record {
  vault_id : nat64;
  stables_consumed : vec record { principal; nat64 };
  collateral_gained : nat64;
  collateral_type : principal;
  success : bool;
  error_message : opt text;
};

type ChainLiquidatableVaultInfo = record {
  sized_repay_e8s : nat;
  cr_e4 : nat64;
  collateral_native : nat;
  vault_id : nat64;
  sp_attempted : bool;
  chain_collateral_sentinel : principal;
  chain_id : nat32;
  liquidation_threshold_e4 : nat64;
  effective_debt_e8s : nat;
  debt_e8s : nat;
};

type ChainStabilityPoolLiquidationResult = record {
  collateral_price_e8s : nat64;
  liquidated_debt_e8s : nat;
  collateral_received_native : nat;
  block_index : nat64;
  claim_id : nat64;
  custody_address : text;
  vault_id : nat64;
  chain_id : nat32;
  success : bool;
};

type ChainSpAbsorbResult = record {
  collateral_price_e8s : nat64;
  liquidated_debt_e8s : nat;
  collateral_received_native : nat;
  block_index : nat64;
  claim_id : nat64;
  custody_address : text;
  vault_id : nat64;
  chain_id : nat32;
  icusd_burned_e8s : nat64;
  success : bool;
};

type IcrcAccount = record {
  owner : principal;
  subaccount : opt vec nat8;
};

type SpProofLedger = variant {
  IcusdBurn;
  ThreePoolTransfer;
};

type SpWritedownProof = record {
  block_index : nat64;
  ledger_kind : SpProofLedger;
  vault_id_memo : nat64;
};

type ChainSpAbsorbIntentStatus = variant {
  Prepared;
  Burned;
  BackendAccepted;
  LocalApplied;
  BackendRejected;
};

type ChainSpAbsorbCandidate = record {
  vault : ChainLiquidatableVaultInfo;
  icusd_to_burn_e8s : nat64;
  pending_status : opt ChainSpAbsorbIntentStatus;
};

type ChainSpAbsorbIntent = record {
  vault_id : nat64;
  chain_id : nat32;
  chain_sentinel : principal;
  icusd_ledger : principal;
  icusd_minting_account : IcrcAccount;
  icusd_to_burn_e8s : nat64;
  stables_consumed : vec record { principal; nat64 };
  burn_created_at_time_ns : nat64;
  status : ChainSpAbsorbIntentStatus;
  burn_proof : opt SpWritedownProof;
  burn_receipt_nat : opt nat;
  legacy_ambiguous_burn : opt bool;
  backend_result : opt ChainStabilityPoolLiquidationResult;
  last_error : opt text;
  created_at_ns : nat64;
  updated_at_ns : nat64;
};

type ChainSpAbsorbCompletion = record {
  vault_id : nat64;
  result : ChainSpAbsorbResult;
  completed_at_ns : nat64;
};

type CfxClaimPayoutRecovery = record {
  chain_sentinel : principal;
  op_id : nat64;
  claim_id : nat64;
  claimant : principal;
  amount_wei : nat;
  reason : text;
  failed_at_ns : nat64;
};

type ChainAbsorbAutoConfig = record {
  enabled : bool;
  interval_seconds : nat64;
  max_scan_per_chain : nat64;
};

type ChainAbsorbAutoTickRecord = record {
  started_at_ns : nat64;
  completed_at_ns : nat64;
  attempted_vault_id : opt nat64;
  candidates_scanned : nat64;
  absorbed : opt ChainSpAbsorbResult;
  error : opt text;
  skipped_reason : opt text;
};

type ChainAbsorbAutoStatus = record {
  config : ChainAbsorbAutoConfig;
  tick_in_flight : bool;
  last_tick : opt ChainAbsorbAutoTickRecord;
};

type PoolLiquidationRecord = record {
  vault_id : nat64;
  timestamp : nat64;
  stables_consumed : vec record { principal; nat64 };
  collateral_gained : nat64;
  collateral_type : principal;
  depositors_count : nat64;
  collateral_price_e8s : opt nat64;
};

// ── Pending refund recovery (audit IC-S-001) ──

type PendingOutboundPayoutStatus = record {
  ledger : principal;
  gross_amount : nat64;
  transfer_amount : nat64;
  transfer_fee : nat64;
  recipient : IcrcAccount;
  from_subaccount : opt blob;
  transfer_memo : blob;
  transfer_created_at_time_ns : nat64;
  dispatch_in_flight : bool;
  ambiguous_seen : bool;
  last_error : opt text;
  reconciliation_attempts : nat64;
  last_reconciliation_at_ns : opt nat64;
  candidate_block_index : opt nat64;
  candidate_block_index_raw : opt text;
};


type CompletedOutboundPayoutStatus = record {
  ledger : principal;
  gross_amount : nat64;
  transfer_amount : nat64;
  transfer_fee : nat64;
  recipient : IcrcAccount;
  from_subaccount : opt blob;
  transfer_memo : blob;
  transfer_created_at_time_ns : nat64;
  block_index : nat64;
  completed_at_ns : nat64;
};
type CompletedOutboundPayoutPage = record {
  items : vec CompletedOutboundPayoutStatus;
  next_cursor : opt nat64;
  has_more : bool;
};
type PendingRefund = record {
  id : nat64;
  user : principal;
  token_ledger : principal;
  amount : nat64;
  reason : text;
  created_at : nat64;
};

type UnallocatedInterestForwardBatch = record {
  id : nat64;
  source_mint_blocks : vec nat64;
  token_ledger : principal;
  treasury : opt principal;
  gross_amount : nat64;
  fee : opt nat64;
  transfer_created_at_ns : opt nat64;
  transfer_block_index : opt nat64;
  treasury_recorded : bool;
  created_at_ns : nat64;
  last_error : opt text;
};

type DepositIntentPhase = variant {
  Prepared;
  Dispatching;
  Reconciling;
  ReceiptVerification;
};

type DepositIntentResult = variant {
  Completed : record { intent_seq : nat64; token_ledger : principal; amount : nat64; block_index : nat64 };
  NoEffect : record { intent_seq : nat64; token_ledger : principal; amount : nat64; reason : text };
  Pending : record { intent_seq : nat64; token_ledger : principal; amount : nat64; phase : DepositIntentPhase; reason : opt text };
};

type DepositIntentStatus = record {
  high_watermark : nat64;
  next_seq : opt nat64;
  intent : opt DepositIntentResult;
  active_intent : opt DepositIntentResult;
};

type ThreeUsdReserveAbsorbIntent = record {
  absorb_id : nat64;
  vault_id : nat64;
  debt_e8s : nat64;
  amount : nat64;
  ledger : principal;
  collateral_type : opt principal;
  collateral_ledger : opt principal;
  collateral_price_e8s : opt nat64;
};
type ThreeUsdAbsorbInventoryCursor = variant {
  AfterPendingVaultId : nat64;
  AfterCompletedAbsorbId : nat64;
};
type ThreeUsdAbsorbInventoryEntry = variant {
  Pending : ThreeUsdReserveAbsorbIntent;
  CompletedAbsorbId : nat64;
};
type ThreeUsdAbsorbInventoryPage = record {
  entries : vec ThreeUsdAbsorbInventoryEntry;
  next_cursor : opt ThreeUsdAbsorbInventoryCursor;
  pending_count : nat64;
  completed_id_count : nat64;
  completed_id_retention_limit : nat64;
  completed_rows_retain_ids_only : bool;
};

// ── Error type ──

type StabilityPoolError = variant {
  InsufficientBalance : record { token : principal; required : nat64; available : nat64 };
  AmountTooLow : record { minimum_e8s : nat64 };
  NoPositionFound;
  InsufficientPoolBalance;
  Unauthorized;
  TokenNotAccepted : record { ledger : principal };
  TokenNotActive : record { ledger : principal };
  CollateralNotFound : record { ledger : principal };
  LedgerTransferFailed : record { reason : text };
  InterCanisterCallFailed : record { target : text; method : text };
  LiquidationFailed : record { vault_id : nat64; reason : text };
  EmergencyPaused;
  SystemBusy;
  AlreadyOptedOut : record { collateral : principal };
  AlreadyOptedIn : record { collateral : principal };
  PayoutAddressRequired : record { collateral : principal };
  InvalidPayoutAddress : record { reason : text };
  XrpClaimStillOutstanding : record { claim_id : nat64 };
  XrpClaimStatusCheckFailed : record { reason : text };
  RefundClaimNotFound;
};

type DepositIntentError = variant {
  InsufficientBalance : record { token : principal; required : nat64; available : nat64 };
  AmountTooLow : record { minimum_e8s : nat64 };
  NoPositionFound;
  InsufficientPoolBalance;
  Unauthorized;
  TokenNotAccepted : record { ledger : principal };
  TokenNotActive : record { ledger : principal };
  CollateralNotFound : record { ledger : principal };
  LedgerTransferFailed : record { reason : text };
  InterCanisterCallFailed : record { target : text; method : text };
  LiquidationFailed : record { vault_id : nat64; reason : text };
  EmergencyPaused;
  SystemBusy;
  DepositIntentSequenceMismatch : record { expected_seq : nat64 };
  DepositIntentSequenceExhausted;
  DepositIntentPayloadMismatch;
  DepositIntentUnresolved : record { active_seq : nat64 };
  DepositIntentCapacityReached;
  AlreadyOptedOut : record { collateral : principal };
  AlreadyOptedIn : record { collateral : principal };
  PayoutAddressRequired : record { collateral : principal };
  InvalidPayoutAddress : record { reason : text };
  XrpClaimStillOutstanding : record { claim_id : nat64 };
  XrpClaimStatusCheckFailed : record { reason : text };
  RefundClaimNotFound;
};

// ── ICRC-21: Canister Call Consent Messages ──

type Icrc21ConsentMessageMetadata = record {
  language : text;
  utc_offset_minutes : opt int16;
};

type Icrc21DeviceSpec = variant {
  GenericDisplay;
  LineDisplay : record {
    characters_per_line : nat16;
    lines_per_page : nat16;
  };
};

type Icrc21ConsentMessageSpec = record {
  metadata : Icrc21ConsentMessageMetadata;
  device_spec : opt Icrc21DeviceSpec;
};

type Icrc21ConsentMessageRequest = record {
  method : text;
  arg : blob;
  user_preferences : Icrc21ConsentMessageSpec;
};

type Icrc21LineDisplayLine = record { line : text };
type Icrc21LineDisplayPage = record { lines : vec Icrc21LineDisplayLine };

type Icrc21ConsentMessage = variant {
  GenericDisplayMessage : text;
  LineDisplayMessage : record { pages : vec Icrc21LineDisplayPage };
};

type Icrc21ConsentMessageResponseMetadata = record {
  language : text;
  utc_offset_minutes : opt int16;
};

type Icrc21ConsentInfo = record {
  consent_message : Icrc21ConsentMessage;
  metadata : Icrc21ConsentMessageResponseMetadata;
};

type Icrc21ErrorInfo = record { description : text };

type Icrc21Error = variant {
  UnsupportedCanisterCall : Icrc21ErrorInfo;
  ConsentMessageUnavailable : Icrc21ErrorInfo;
  GenericError : record { error_code : nat; description : text };
};

type Icrc21ConsentMessageResponse = variant {
  Ok : Icrc21ConsentInfo;
  Err : Icrc21Error;
};

// ── ICRC-10: Supported Standards ──

// ── Pool Events ──

type PoolEventType = variant {
  Deposit : record { token_ledger : principal; amount : nat64 };
  Withdraw : record { token_ledger : principal; amount : nat64 };
  ClaimCollateral : record { collateral_ledger : principal; amount : nat64 };
  DepositAs3USD : record { token_ledger : principal; amount_in : nat64; lp_minted : nat64 };
  InterestReceived : record { token_ledger : principal; amount : nat64 };
  OptOutCollateral : record { collateral_type : principal };
  OptInCollateral : record { collateral_type : principal };
  LiquidationNotification : record { vault_count : nat64 };
  LiquidationExecuted : record {
    vault_id : nat64;
    stables_consumed_e8s : nat64;
    collateral_gained : nat64;
    collateral_type : principal;
    success : bool;
  };
  StablecoinRegistered : record { ledger : principal; symbol : text };
  CollateralRegistered : record { ledger : principal; symbol : text };
  ConfigurationUpdated;
  EmergencyPauseActivated;
  OperationsResumed;
  BalanceCorrected : record { user : principal; token_ledger : principal; new_amount : nat64 };
  CollateralGainCorrected : record { user : principal; collateral_ledger : principal; new_amount : nat64 };
};

type PoolEvent = record {
  id : nat64;
  timestamp : nat64;
  caller : principal;
  event_type : PoolEventType;
};

type Icrc10SupportedStandard = record {
  name : text;
  url : text;
};

// ──────────────────────────────────────────────────────────────
// Service
// ──────────────────────────────────────────────────────────────

type InterestRecoveryWire_InterestMintReceiptPayload = record {
  collateral_type : opt principal;
  amount : nat64;
  token_ledger : principal;
};
type InterestRecoveryWire_RecoveryManifest = record {
  packets : vec InterestRecoveryWire_RecoveryPacket;
  baseline_digest : blob;
};
type InterestRecoveryWire_RecoveryPacket = record {
  source_mint_block : nat64;
  allocations : vec record { principal; nat64 };
  collateral_type : principal;
  amount : nat64;
  token_ledger : principal;
};
type InterestRecoveryWire_RecoveryPacketReceipt = record {
  source_mint_block : nat64;
  allocation_digest : blob;
  manifest_hash : blob;
  credited : bool;
  payload : InterestRecoveryWire_InterestMintReceiptPayload;
};
type InterestRecoveryWire_RecoveryStatus = record {
  next_packet : nat16;
  manifest_hash : blob;
  credited_raw : nat64;
  packet_count : nat16;
  live_interest_only : bool;
};
type InterestRecoveryWire_Result_10 = variant { Ok : opt InterestRecoveryWire_RecoveryPacketReceipt; Err : text };
type InterestRecoveryWire_Result_11 = variant { Ok : opt InterestRecoveryWire_RecoveryStatus; Err : text };
type InterestRecoveryWire_Result_7 = variant { Ok : InterestRecoveryWire_RecoveryStatus; Err : text };
type WithdrawalWire_Account = record { owner : principal; subaccount : opt blob };
type WithdrawalWire_PendingOutboundPayoutStatus = record {
  last_error : opt text;
  ambiguous_seen : bool;
  transfer_fee : nat64;
  reconciliation_attempts : nat64;
  last_reconciliation_at_ns : opt nat64;
  recipient : WithdrawalWire_Account;
  transfer_amount : nat64;
  from_subaccount : opt blob;
  transfer_created_at_time_ns : nat64;
  ledger : principal;
  candidate_block_index : opt nat64;
  dispatch_in_flight : bool;
  candidate_block_index_raw : opt text;
  transfer_memo : blob;
  gross_amount : nat64;
};
type WithdrawalWire_Result_6 = variant { Ok : nat64; Err : WithdrawalWire_StabilityPoolError };
type WithdrawalWire_StabilityPoolError = variant {
  LedgerTransferFailed : record { reason : text };
  RefundClaimNotFound;
  EmergencyPaused;
  AlreadyOptedOut : record { collateral : principal };
  TokenNotActive : record { ledger : principal };
  InsufficientBalance : record {
    token : principal;
    available : nat64;
    required : nat64;
  };
  InvalidPayoutAddress : record { reason : text };
  CollateralNotFound : record { ledger : principal };
  NoPositionFound;
  AmountTooLow : record { minimum_e8s : nat64 };
  Unauthorized;
  InterCanisterCallFailed : record { method : text; target : text };
  PayoutAddressRequired : record { collateral : principal };
  XrpClaimStillOutstanding : record { claim_id : nat64 };
  LiquidationFailed : record { vault_id : nat64; reason : text };
  XrpClaimStatusCheckFailed : record { reason : text };
  SystemBusy;
  AlreadyOptedIn : record { collateral : principal };
  TokenNotAccepted : record { ledger : principal };
  InsufficientPoolBalance;
};
type SpRailWire_Account = record { owner : principal; subaccount : opt blob };
type SpRailWire_ConversionError = variant {
  EmergencyPaused;
  CapacityExceeded;
  SequenceExhausted;
  NonZeroFeeBudgetRequired : record {
    minimum_budget_raw : nat64;
    fee_raw : nat64;
  };
  TokenNotActive : record { ledger : principal };
  IntentConflict;
  SequenceMismatch : record { expected_seq : nat64 };
  NotFound;
  AmountTooLow : record { minimum_e8s : nat64 };
  Unauthorized;
  InvalidRequest : record { reason : text };
  LpTokenUnavailable;
  ActiveIntent : record { intent_seq : nat64 };
  CannotCancel;
  SystemBusy;
  TokenNotAccepted : record { ledger : principal };
};
type SpRailWire_ConversionPhase = variant {
  Refunding;
  Revoking;
  Reserved;
  Refunded;
  Pulling;
  Rejected;
  Approving;
  PoolCall;
  CreditPending;
  Completed;
};
type SpRailWire_ConversionQuote = record {
  lp_ledger : principal;
  quoted_lp : nat;
  pool_coin_index : nat8;
  minimum_fee_budget_raw : nat64;
  principal_raw : nat64;
  live_transfer_fee_raw : nat64;
  token_ledger : principal;
  pool_canister : principal;
};
type SpRailWire_ConversionRequest = record {
  min_lp : nat;
  max_fee_budget_raw : nat64;
  principal_raw : nat64;
  intent_seq : nat64;
  token_ledger : principal;
};
type SpRailWire_ConversionStatus = variant {
  Refunded : record {
    refunded_raw : nat64;
    retained_dust_raw : nat64;
    intent_seq : nat64;
  };
  Rejected : record { intent_seq : nat64; reason : text };
  Completed : record {
    uncredited_lp : opt nat;
    retained_dust_raw : nat64;
    lp_credited : bool;
    lp_minted : nat;
    intent_seq : nat64;
  };
  Pending : record {
    phase : SpRailWire_ConversionPhase;
    intent_seq : nat64;
    reason : opt text;
  };
};
type SpRailWire_ConversionView = record {
  status : SpRailWire_ConversionStatus;
  request : SpRailWire_ConversionRequest;
};
type SpRailWire_LiquidationResult = record {
  admitted : opt bool;
  error_message : opt text;
  stables_consumed : vec record { principal; nat64 };
  vault_id : nat64;
  collateral_gained : nat64;
  success : bool;
  collateral_type : principal;
};
type SpRailWire_OrdinaryApprovalTuple = record {
  created_at_time_ns : nat64;
  memo : blob;
  fee_raw : nat64;
  amount_raw : nat64;
  ledger : principal;
  spender : principal;
  expires_at_time_ns : nat64;
};
type SpRailWire_OrdinaryLiquidationPhase = variant {
  BackendPrepared;
  ApprovalConfirmed;
  CancellationSubmitted;
  PaymentConfirmed;
  PaymentNoEffect;
  BackendSubmitted;
  Prepared;
  ApprovalSubmitted;
  PayoutNoEffect;
  Cancelled;
  PayoutHeld;
  Completed;
};
type SpRailWire_OrdinaryLiquidationQuote = record {
  payout_tuple : opt SpRailWire_OrdinaryPayoutTuple;
  payout_operation_id : opt nat;
  collateral_price_e8s : nat64;
  collateral_gross_raw : nat64;
  pull_fee_raw : nat64;
  payment_block_index : opt nat64;
  payout_block_index : opt nat64;
  payout_net_raw : opt nat64;
  surcharge_raw : nat64;
  principal_raw : nat64;
  collateral_ledger : principal;
  collateral_net_raw : nat64;
  gross_payment_raw : nat64;
  collateral_fee_raw : nat64;
  payment_tuple : SpRailWire_OrdinaryPaymentTuple;
  debt_e8s : nat64;
};
type SpRailWire_OrdinaryLiquidationStatus = record {
  request_id : blob;
  last_error : opt text;
  approval_attempted : bool;
  stable_ledger : principal;
  backend_attempted : bool;
  quote : opt SpRailWire_OrdinaryLiquidationQuote;
  vault_id : nat64;
  approval : opt SpRailWire_OrdinaryApprovalTuple;
  phase : SpRailWire_OrdinaryLiquidationPhase;
  collateral_type : principal;
  payment : SpRailWire_SpLiquidationPayment;
};
type SpRailWire_OrdinaryPaymentTuple = record {
  destination : SpRailWire_Account;
  source : SpRailWire_Account;
  created_at_time_ns : nat64;
  memo : blob;
  amount_raw : nat64;
  ledger_fee_raw : nat64;
  ledger : principal;
  op_nonce : nat;
};
type SpRailWire_OrdinaryPayoutTuple = record {
  destination : SpRailWire_Account;
  source : SpRailWire_Account;
  created_at_time_ns : nat64;
  memo : blob;
  amount_raw : nat64;
  ledger_fee_raw : nat64;
  ledger : principal;
  op_nonce : nat;
  gross_raw : nat64;
};
type SpRailWire_Result = variant { Ok; Err : SpRailWire_StabilityPoolError };
type SpRailWire_Result_11 = variant { Ok : nat64; Err : SpRailWire_ConversionError };
type SpRailWire_Result_15 = variant { Ok : SpRailWire_ConversionQuote; Err : SpRailWire_ConversionError };
type SpRailWire_Result_4 = variant { Ok : SpRailWire_ConversionStatus; Err : SpRailWire_ConversionError };
type SpRailWire_Result_5 = variant { Ok : SpRailWire_LiquidationResult; Err : SpRailWire_StabilityPoolError };
type SpRailWire_SpLiquidationPayment = variant { Icusd; Ckusdc; Ckusdt };
type SpRailWire_StabilityPoolError = variant {
  LedgerTransferFailed : record { reason : text };
  RefundClaimNotFound;
  EmergencyPaused;
  AlreadyOptedOut : record { collateral : principal };
  TokenNotActive : record { ledger : principal };
  InsufficientBalance : record {
    token : principal;
    available : nat64;
    required : nat64;
  };
  InvalidPayoutAddress : record { reason : text };
  CollateralNotFound : record { ledger : principal };
  NoPositionFound;
  AmountTooLow : record { minimum_e8s : nat64 };
  Unauthorized;
  InterCanisterCallFailed : record { method : text; target : text };
  PayoutAddressRequired : record { collateral : principal };
  XrpClaimStillOutstanding : record { claim_id : nat64 };
  LiquidationFailed : record { vault_id : nat64; reason : text };
  XrpClaimStatusCheckFailed : record { reason : text };
  SystemBusy;
  AlreadyOptedIn : record { collateral : principal };
  TokenNotAccepted : record { ledger : principal };
  InsufficientPoolBalance;
};
type SpRailWire_IntentionalDrift_LiquidationResult = record {
  admitted : opt bool;
  error_message : opt text;
  stables_consumed : vec record { principal; nat64 };
  vault_id : nat64;
  collateral_gained : nat64;
  success : bool;
  collateral_type : principal;
};
service : (StabilityPoolInitArgs) -> {

  // ── Deposit / Withdraw / Claim ──
  deposit : (principal, nat64) -> (variant { Ok; Err : StabilityPoolError });
  deposit_with_intent : (nat64, principal, nat64) -> (variant { Ok : DepositIntentResult; Err : DepositIntentError });
  get_deposit_intent : (nat64) -> (DepositIntentStatus);
  admin_get_three_usd_absorb_inventory_page : (
    opt ThreeUsdAbsorbInventoryCursor,
    nat16,
  ) -> (variant { Ok : ThreeUsdAbsorbInventoryPage; Err : StabilityPoolError }) query;
  withdraw : (principal, nat64) -> (variant { Ok; Err : StabilityPoolError });
  deposit_as_3usd : (principal, nat64) -> (variant { Ok : nat64; Err : StabilityPoolError });
  claim_collateral : (principal) -> (variant { Ok : nat64; Err : StabilityPoolError });
  reconcile_collateral_claim : (principal, principal, nat64) -> (variant { Ok : nat64; Err : StabilityPoolError });
  claim_all_collateral : () -> (variant { Ok : vec record { principal; nat64 }; Err : StabilityPoolError });
  claim_pending_refund : (nat64) -> (variant { Ok : nat64; Err : StabilityPoolError });
  claim_cfx : (principal, text) -> (variant { Ok : nat; Err : StabilityPoolError });
  recredit_failed_cfx_claim_payout : (CfxClaimPayoutRecovery) -> (variant { Ok : bool; Err : StabilityPoolError });

  // ── Opt-in / Opt-out ──
  opt_out_collateral : (principal) -> (variant { Ok; Err : StabilityPoolError });
  opt_in_collateral : (principal) -> (variant { Ok; Err : StabilityPoolError });
  opt_out_cfx : (principal) -> (variant { Ok; Err : StabilityPoolError });
  opt_in_cfx : (principal) -> (variant { Ok; Err : StabilityPoolError });
  opt_in_native_collateral : (principal, text) -> (variant { Ok; Err : StabilityPoolError });
  opt_in_native_collateral_with_tag : (principal, text, opt nat32) -> (variant { Ok; Err : StabilityPoolError });
  ack_native_xrp_payout_settled : (nat64) -> (variant { Ok; Err : StabilityPoolError });

  // ── Liquidation ──

  sp_absorb_chain_vault : (nat64) -> (variant { Ok : ChainSpAbsorbResult; Err : StabilityPoolError });
  admin_recover_ambiguous_chain_burn : (nat64, opt nat64) -> (variant { Ok : ChainSpAbsorbResult; Err : StabilityPoolError });
  admin_recover_ambiguous_native_xrp_burn : (nat64, opt nat64) -> (variant { Ok; Err : StabilityPoolError });
  scan_chain_absorb_candidates : (opt nat64) -> (variant { Ok : vec ChainSpAbsorbCandidate; Err : StabilityPoolError });
  set_chain_absorb_auto_config : (ChainAbsorbAutoConfig) -> (variant { Ok; Err : StabilityPoolError });

  // ── Interest Revenue ──
  receive_interest_revenue : (principal, nat64, opt principal) -> (variant { Ok; Err : StabilityPoolError });
  receive_interest_revenue_v2 : (principal, nat64, opt principal, nat64) -> (variant { Ok; Err : StabilityPoolError });

  // ── Admin: Registry ──
  register_stablecoin : (StablecoinConfig) -> (variant { Ok; Err : StabilityPoolError });
  register_collateral : (CollateralInfo) -> (variant { Ok; Err : StabilityPoolError });
  register_cfx_collateral : (nat32) -> (variant { Ok : principal; Err : StabilityPoolError });

  // ── Admin: Configuration ──
  update_pool_configuration : (PoolConfiguration) -> (variant { Ok; Err : StabilityPoolError });
  set_interest_treasury : (opt principal) -> (variant { Ok; Err : StabilityPoolError });
  retry_unallocated_interest_forward : (nat64) -> (variant { Ok; Err : StabilityPoolError });
  confirm_unallocated_interest_forward_transfer : (nat64, nat64) -> (variant { Ok; Err : StabilityPoolError });
  emergency_pause : () -> (variant { Ok; Err : StabilityPoolError });
  resume_operations : () -> (variant { Ok; Err : StabilityPoolError });
  admin_correct_balance : (principal, principal, nat64) -> (variant { Ok : text; Err : StabilityPoolError });
  admin_correct_collateral_gain : (principal, principal, nat64) -> (variant { Ok : text; Err : StabilityPoolError });

  // ── ICRC-21: Consent Messages ──
  icrc21_canister_call_consent_message : (Icrc21ConsentMessageRequest) -> (Icrc21ConsentMessageResponse);

  // ── ICRC-10: Supported Standards ──
  icrc10_supported_standards : () -> (vec Icrc10SupportedStandard) query;

  // ── Queries ──
  cycles_status : () -> (CycleManagerCyclesStatus) query;
  cycle_manager_metrics : () -> (vec CycleManagerMetric) query;
  get_pool_status : () -> (StabilityPoolStatus) query;
  get_interest_mint_receipt_capacity : () -> (InterestMintReceiptCapacity) query;
  get_user_position : (opt principal) -> (opt UserStabilityPosition) query;
  get_liquidation_history : (opt nat64) -> (vec PoolLiquidationRecord) query;
  check_pool_capacity : (principal, nat64) -> (bool) query;
  check_chain_absorb_capacity : (principal, nat64) -> (bool) query;
  validate_pool_state : () -> (variant { Ok : text; Err : text }) query;
  get_ledger_reconciliation : () -> (
      variant { Ok : vec LedgerReconciliationEntry; Err : StabilityPoolError },
    );
  get_pool_events : (nat64, nat64) -> (vec PoolEvent) query;
  get_pool_event_count : () -> (nat64) query;
  list_depositor_principals : () -> (vec principal) query;
  get_pending_refunds : (opt principal) -> (vec PendingRefund) query;
  get_my_pending_collateral_claims : () -> (vec PendingOutboundPayoutStatus) query;
  // Bounded compatibility view; use the cursor method for complete history.
  get_my_completed_collateral_claims : () -> (vec CompletedOutboundPayoutStatus) query;
  get_my_completed_collateral_claims_page : (opt nat64, nat16) -> (CompletedOutboundPayoutPage) query;
  get_pending_unallocated_interest_forwards : () -> (vec UnallocatedInterestForwardBatch) query;
  get_my_native_xrp_payouts : () -> (vec NativeXrpPendingPayout) query;
  get_pending_chain_absorbs : () -> (vec ChainSpAbsorbIntent) query;
  get_completed_chain_absorbs : (opt nat64) -> (vec ChainSpAbsorbCompletion) query;
  get_chain_absorb_auto_status : () -> (ChainAbsorbAutoStatus) query;
  get_chain_collateral_sentinel : (nat32) -> (principal) query;

  stage_interest_recovery : (InterestRecoveryWire_RecoveryManifest) -> (InterestRecoveryWire_Result_7);
  continue_interest_recovery : (blob, nat16, nat8) -> (InterestRecoveryWire_Result_7);
  finish_interest_recovery : (blob) -> (InterestRecoveryWire_Result_7);
  get_interest_recovery_status : () -> (InterestRecoveryWire_Result_11) query;
  get_interest_recovery_packet_receipt : (nat64) -> (InterestRecoveryWire_Result_10);

  get_my_pending_withdrawals : () -> (vec WithdrawalWire_PendingOutboundPayoutStatus) query;
  reconcile_withdrawal : (principal, principal, nat64) -> (WithdrawalWire_Result_6);
start_3usd_conversion : (SpRailWire_ConversionRequest) -> (SpRailWire_Result_4);
resume_3usd_conversion : (nat64) -> (SpRailWire_Result_4);
reconcile_3usd_conversion_pull_v1 : (nat64, nat64) -> (SpRailWire_Result_4);
get_3usd_conversion_status : (nat64) -> (SpRailWire_Result_4) query;
get_active_3usd_conversion : () -> (opt SpRailWire_ConversionStatus) query;
get_3usd_conversion_next_seq : () -> (SpRailWire_Result_11) query;
get_active_3usd_conversion_v1 : () -> (opt SpRailWire_ConversionView) query;
cancel_3usd_conversion : (nat64) -> (SpRailWire_Result_4);
quote_3usd_conversion : (principal, nat64, nat) -> (SpRailWire_Result_15);
get_ordinary_liquidation_status : (blob) -> (
      opt SpRailWire_OrdinaryLiquidationStatus,
    ) query;
retry_ordinary_liquidation : (blob) -> (SpRailWire_Result_5);
cancel_ordinary_liquidation : (blob) -> (SpRailWire_Result_5);
reconcile_3usd_conversion_pool_input_v1 : (nat64, nat8, nat64) -> (SpRailWire_Result_4);
reconcile_ordinary_liquidation_approval : (blob, nat64) -> (SpRailWire_Result_5);
admin_acknowledge_three_usd_reserve_v2_client : () -> (SpRailWire_Result);
notify_liquidatable_vaults : (vec LiquidatableVaultInfo) -> (vec SpRailWire_IntentionalDrift_LiquidationResult);
execute_liquidation : (nat64) -> (variant { Ok : SpRailWire_IntentionalDrift_LiquidationResult; Err : StabilityPoolError });};

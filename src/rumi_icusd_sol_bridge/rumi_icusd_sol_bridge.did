type Account = record { owner : principal; subaccount : opt blob };
type BridgeArg = variant { Upgrade : UpgradeArgs; Init : InitArgs };
type BridgeError = variant {
  Internal : text;
  Anonymous;
  Paused : text;
  Unauthorized;
  NotConfigured : text;
  InvalidArgument : text;
  Halted : text;
  InvalidState : text;
};
type BridgeFees = record { release_fee_e8s : nat64; deposit_fee_e8s : nat64 };
type BridgeInfo = record {
  initialized : bool;
  fees : BridgeFees;
  memo_program : text;
  escrow_subaccount : text;
  sol_rpc : principal;
  schema_version : nat32;
  schnorr_key_name : text;
  admins : vec principal;
  token_program : TokenProgram;
  halted : opt text;
  icusd_ledger : principal;
  genesis_hash : text;
  instance_salt : text;
  pauses : Pauses;
};
type BucketsView = record {
  reserved_pulls : nat;
  pending_mint : nat;
  unknown_outflow : nat;
  pending_refund : nat;
  outstanding : nat;
  fees : nat;
  held : nat;
  burn_unknown : nat;
  stray : nat;
  return_custodied : nat;
  pending_release : nat;
};
type ConsentInfo = record {
  metadata : ConsentMessageMetadata;
  consent_message : ConsentMessage;
};
type ConsentMessage = variant {
  LineDisplayMessage : record { pages : vec LineDisplayPage };
  GenericDisplayMessage : text;
};
type ConsentMessageMetadata = record {
  utc_offset_minutes : opt int16;
  language : text;
};
type ConsentMessageRequest = record {
  arg : blob;
  method : text;
  user_preferences : ConsentMessageSpec;
};
type ConsentMessageSpec = record {
  metadata : ConsentMessageMetadata;
  device_spec : opt DeviceSpec;
};
type DeviceSpec = variant {
  GenericDisplay;
  LineDisplay : record { characters_per_line : nat16; lines_per_page : nat16 };
};
type ErrorInfo = record { description : text };
type Icrc21Error = variant {
  GenericError : record { description : text; error_code : nat64 };
  UnsupportedCanisterCall : ErrorInfo;
  ConsentMessageUnavailable : ErrorInfo;
};
type Icrc28TrustedOriginsResponse = record { trusted_origins : vec text };
type InitArgs = record {
  fee_recipient : opt Account;
  memo_program : text;
  sol_rpc : principal;
  schnorr_key_name : text;
  admins : vec principal;
  token_program : TokenProgram;
  icusd_ledger : principal;
  genesis_hash : text;
};
type LineDisplayPage = record { lines : vec text };
type Pauses = record {
  mints : bool;
  observer : bool;
  releases : bool;
  deposits : bool;
};
type Result = variant { Ok : ConsentInfo; Err : Icrc21Error };
type Result_1 = variant { Ok; Err : BridgeError };
type StandardRecord = record { url : text; name : text };
type TokenProgram = variant { Classic; Token2022 };
type UpgradeArgs = record { admins : opt vec principal };
service : (BridgeArg) -> {
  bridge_version : () -> (text) query;
  get_bridge_info : () -> (BridgeInfo) query;
  get_buckets : () -> (BucketsView) query;
  icrc10_supported_standards : () -> (vec StandardRecord) query;
  icrc21_canister_call_consent_message : (ConsentMessageRequest) -> (Result);
  icrc28_trusted_origins : () -> (Icrc28TrustedOriginsResponse) query;
  set_admins : (vec principal) -> (Result_1);
}
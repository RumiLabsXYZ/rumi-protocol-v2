type BotConfig = record {
  backend_principal : principal;
  treasury_principal : principal;
  admin : principal;
  max_slippage_bps : nat16;
  icp_ledger : principal;
  ckusdc_ledger : principal;
  icpswap_pool : principal;
  icpswap_zero_for_one : opt bool;
  icp_fee_e8s : opt nat64;
  ckusdc_fee_e6 : opt nat64;
  // Legacy fields (ignored, kept for deserialization compat)
  three_pool_principal : opt principal;
  kong_swap_principal : opt principal;
  ckusdt_ledger : opt principal;
  icusd_ledger : opt principal;
};

type BotInitArgs = record {
  config : BotConfig;
};

type BotStats = record {
  total_debt_covered_e8s : nat64;
  total_ckusdc_deposited_e6 : nat64;
  total_ckusdc_surplus_held_e6 : nat64;
  total_collateral_received_e8s : nat64;
  total_collateral_to_treasury_e8s : nat64;
  events_count : nat64;
};

type LiquidatableVaultInfo = record {
  vault_id : nat64;
  collateral_type : principal;
  debt_amount : nat64;
  collateral_amount : nat64;
  recommended_liquidation_amount : nat64;
  collateral_price_e8s : nat64;
};

type LiquidationStatus = variant {
  Completed;
  SwapFailed;
  TransferFailed;
  ConfirmFailed;
  ClaimFailed;
  AdminResolved;
};

type LiquidationRecordV1 = record {
  id : nat64;
  vault_id : nat64;
  timestamp : nat64;
  status : LiquidationStatus;
  collateral_claimed_e8s : nat64;
  debt_to_cover_e8s : nat64;
  icp_swapped_e8s : nat64;
  ckusdc_received_e6 : nat64;
  ckusdc_transferred_e6 : nat64;
  icp_to_treasury_e8s : nat64;
  oracle_price_e8s : nat64;
  effective_price_e8s : nat64;
  slippage_bps : int32;
  error_message : opt text;
  confirm_retry_count : nat8;
};

type LiquidationRecordVersioned = variant {
  V1 : LiquidationRecordV1;
};

type BotAdminAction = variant {
  ConfigUpdated;
  VaultsNotified : record { count : nat64 };
};

type BotAdminEvent = record {
  timestamp : nat64;
  caller : text;
  action : BotAdminAction;
};

type SwapResult = record {
  ckusdc_received_e6 : nat64;
  effective_price_e8s : nat64;
};
type TransferReceipt = record {
  block_index : nat64;
  amount : nat64;
  created_at_time : nat64;
};
type BotPaymentStatus = variant { Prepared; Ambiguous; NoEffect; ReceiptObserved; Confirmed };
type BotPaymentTopUpJournal = record {
  backend_principal : principal;
  ledger_principal : principal;
  amount_e6 : nat64;
  fee_e6 : nat64;
  created_at_time : nat64;
  memo : blob;
  funding_allocation_e6 : nat64;
  status : BotPaymentStatus;
  receipt : opt TransferReceipt;
};
type BotPaymentJournal = record {
  record_id : opt nat64;
  vault_id : nat64;
  backend_principal : principal;
  ledger_principal : principal;
  claim_generation : nat64;
  debt_covered_e8s : nat64;
  collateral_amount_e8s : nat64;
  collateral_received_amount_e8s : opt nat64;
  collateral_price_e8s : nat64;
  icp_swapped_e8s : nat64;
  ckusdc_received_e6 : nat64;
  held_surplus_e6 : nat64;
  gross_amount_e6 : nat64;
  amount_e6 : nat64;
  fee_e6 : nat64;
  created_at_time : nat64;
  memo : blob;
  status : BotPaymentStatus;
  receipt : opt TransferReceipt;
  shortfall_receipt_observed : bool;
  shortfall_topup : opt BotPaymentTopUpJournal;
};
type BotReturnTransferStatus = variant { Prepared; Ambiguous; NoEffect; ReceiptObserved; FeeMismatchAmbiguous };
type BotReturnTransferJournal = record {
  ledger_principal : principal;
  backend_principal : principal;
  amount_e8s : nat64;
  fee_e8s : nat64;
  transfer_fee_e8s : opt nat64;
  memo : blob;
  created_at_time : nat64;
  receipt : opt TransferReceipt;
  status : BotReturnTransferStatus;
};
type BotClaimJournalStatus = variant { SwapMayHaveStarted; ReturnFeeQueryPending; ReturnFeeRefreshExhausted; ReturnPending; PaymentShortfall };
type BotSwapIntent = record {
  pool_principal : principal;
  input_ledger_principal : principal;
  output_ledger_principal : principal;
  amount_in_e8s : nat64;
  amount_out_minimum_e6 : nat64;
  zero_for_one : bool;
  input_fee_e8s : nat64;
  output_fee_e6 : nat64;
  attempt_ordinal : nat32;
  created_at_time : nat64;
  pre_swap_ckusdc_balance_e6 : nat64;
};
type BotClaimJournal = record {
  vault_id : nat64;
  claim_generation : nat64;
  debt_covered_e8s : nat64;
  collateral_amount_e8s : nat64;
  collateral_received_amount_e8s : opt nat64;
  collateral_outbound_fee_e8s : opt nat64;
  collateral_price_e8s : nat64;
  payment_memo : blob;
  collateral_return_memo : blob;
  failed_return_attempts : vec BotReturnTransferJournal;
  collateral_return : opt BotReturnTransferJournal;
  swap_intents : vec BotSwapIntent;
  status : BotClaimJournalStatus;
};
type BotTreasuryStatus = variant { NeedsPreparation; Prepared; Ambiguous; NoEffect; ReceiptObserved; Paid };
type BotTreasuryIntentView = record {
  record_id : nat64;
  vault_id : nat64;
  claim_generation : nat64;
  ledger_principal : principal;
  sender_principal : principal;
  treasury_principal : principal;
  gross_amount_e8s : nat64;
  amount_e8s : nat64;
  fee_e8s : nat64;
  memo : blob;
  created_at_time : nat64;
  status : BotTreasuryStatus;
  receipt : opt TransferReceipt;
};

type TestSwapResult = variant { Ok : SwapResult; Err : text };

type CycleManagerCyclesStatus = record {
  balance : nat;
  low_watermark : nat;
  healthy : bool;
  freeze_threshold_secs : nat64;
  stable_memory_bytes : opt nat64;
  heap_memory_bytes : opt nat64;
  idle_burn_cycles_per_day : opt nat;
};
type CycleManagerMetric = record {
  key : text;
  count : nat64;
  value : nat;
  label : opt text;
};

service : (BotInitArgs) -> {
  // Core
  notify_liquidatable_vaults : (vec LiquidatableVaultInfo) -> ();
  set_config : (BotConfig) -> ();
  set_processing_paused : (bool) -> (variant { Ok; Err : text });
  get_processing_paused : () -> (bool) query;

  // Stats
  cycles_status : () -> (CycleManagerCyclesStatus) query;
  cycle_manager_metrics : () -> (vec CycleManagerMetric) query;
  get_bot_stats : () -> (BotStats) query;

  // History
  get_liquidation : (nat64) -> (opt LiquidationRecordVersioned) query;
  get_liquidations : (nat64, nat64) -> (vec LiquidationRecordVersioned) query;
  get_liquidation_count : () -> (nat64) query;
  get_stuck_liquidations : () -> (vec LiquidationRecordVersioned) query;
  get_liquidation_events : (nat64, nat64) -> (vec LiquidationRecordVersioned) query;

  // Admin events
  get_admin_events : (nat64, nat64) -> (vec BotAdminEvent) query;
  get_admin_event_count : () -> (nat64) query;
  get_pending_payment_journals : () -> (vec BotPaymentJournal) query;
  get_pending_claim_journals : () -> (vec BotClaimJournal) query;
  get_pending_treasury_intent : (nat64) -> (opt BotTreasuryIntentView) query;

  // Admin actions
  admin_resolve_pool_ordering : () -> ();
  admin_approve_pool : () -> ();
  admin_sweep_ckusdc : (principal, opt nat64) -> ();
  admin_retry_stuck_claim : (nat64) -> ();
  admin_authorize_shortfall_topup : (nat64, nat64) -> (variant { Ok; Err : text });
  admin_reconcile_payment_block : (nat64, nat64) -> (variant { Ok; Err : text });
  admin_reconcile_shortfall_topup_block : (nat64, nat64) -> (variant { Ok; Err : text });
  admin_reconcile_treasury_block : (nat64, nat64) -> (variant { Ok; Err : text });
  admin_reconcile_return_block : (nat64, nat64) -> (variant { Ok; Err : text });
  // Returns (icp_fee_e8s, ckusdc_fee_e6) freshly read from each ledger and
  // also writes them back into BotConfig so future swaps use the live values.
  admin_refresh_fees : () -> (nat64, nat64);
  // Runs the live swap path (ICP -> ckUSDC) using `amount_e8s` from the bot's
  // ICP balance. ckUSDC stays in the bot; retrieve via `admin_sweep_ckusdc`.
  admin_test_swap : (nat64) -> (TestSwapResult);
};

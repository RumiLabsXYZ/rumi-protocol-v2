  PreTransferRejected : record { reason : text };
  TransferConfirmed : record {
    tuple : ThreeUsdReserveIngressTuple;
    block_index : nat64;
  };
  AdmissionPending;
  Absorbed : record {
    result : StabilityPoolLiquidationResult;
    tuple : ThreeUsdReserveIngressTuple;
    block_index : nat64;
  };
  FailedAfterTransfer : record {
    tuple : ThreeUsdReserveIngressTuple;
    block_index : nat64;
    error : text;
  };
  NoTransferProven : record {
    tip_log_length : nat64;
    tuple : ThreeUsdReserveIngressTuple;
  };
  SubmittedOrUnknown : record { tuple : ThreeUsdReserveIngressTuple };
};

type Account = record { owner : principal; subaccount : opt blob };
type AddCollateralArg = record {
  redemption_fee_ceiling : opt float64;
  debt_ceiling : nat64;
  min_vault_debt : nat64;
  min_collateral_deposit : nat64;
  redemption_tier : opt nat8;
  redemption_fee_floor : opt float64;
  borrow_threshold_ratio : float64;
  ledger_canister_id : principal;
  price_source : PriceSource;
  liquidation_bonus : float64;
  display_color : opt text;
  borrowing_fee : float64;
  interest_rate_apr : float64;
  liquidation_ratio : float64;
};
type AddMarginRecovery = record {
  payout_operation_id : nat;
  block_index : nat64;
  vault_id : nat64;
  ledger : principal;
  amount : nat64;
};
type AddMarginV2Args = record {
  operation_id : nat64;
  vault_id : nat64;
  amount : nat64;
};
type Amm1DonationInspectionPage = record {
  total : nat64;
  items : vec Amm1DonationInspectionRow;
  next_offset : opt nat64;
};
type Amm1DonationInspectionRow = record {
  status : text;
  mint_op_nonce : opt nat;
  amount_e8s : nat64;
  amm_canister : opt principal;
  ledger : opt principal;
  mint_block_index : opt nat64;
  pool_id : opt text;
  reward_subaccount : opt blob;
  notify_nonce : nat64;
  reason : opt text;
};
type AssetType = variant { ICP; CKUSDC; CKUSDT; ICUSD; CKBTC };
type AttemptStatus = variant {
  Prepared;
  FailedOnLedger : record { result : text };
  Submitted;
  Quarantined : record { reason : text };
  Validated : record { ledger_index : nat32 };
  Signed;
  Expired : record { validated_ledger : nat32 };
};
type BorrowFeeMintPhase = variant {
  ReceiptRecoveryRequired;
  TreasuryMissing;
  NotificationPending : record { mint_block_index : nat64 };
  SubmittedOrUnknown;
};
type BorrowFeeMintRecoveryPage = record {
  next_cursor : opt nat;
  items : vec BorrowFeeMintStatus;
};
type BorrowFeeMintStatus = record {
  tuple : opt BorrowMintTuple;
  owner : principal;
  borrow_block_index : nat64;
  fee_amount_e8s : nat64;
  vault_id : nat64;
  to_repay_e8s : nat64;
  phase : BorrowFeeMintPhase;
  borrow_op_nonce : nat;
  treasury : opt principal;
  to_treasury_e8s : nat64;
};
type BorrowMintAbsenceScan = record {
  fixed_tip : opt nat64;
  candidate_block_index : opt nat64;
  next_block_index : nat64;
};
type BorrowMintPhase = variant {
  ReceiptRecoveryRequired;
  MintConfirmedHeld : record { block_index : nat64 };
  SubmittedOrUnknown;
};
type BorrowMintStatus = record {
  vault_id : nat64;
  borrowed_amount_e8s : nat64;
  phase : BorrowMintPhase;
};
type BorrowMintTuple = record {
  destination : principal;
  created_at_time_ns : nat64;
  memo : blob;
  amount_e8s : nat64;
  ledger : principal;
  op_nonce : nat;
};
type BorrowToXrplArg = record {
  request_nonce : blob;

    refund_fee_e8s : nat64;
  };
  TransferSubmittedOrUnknown;
  PreTransferRejected : record { reason : text };
  TransferConfirmed : record { transfer_block_index : nat64 };
  FailedRefundPending : record {
    transfer_block_index : nat64;
    refund_amount_e8s : nat64;
    error : text;
  };
  AdmissionPending;
  Unseen;
  Absorbed : record {
    result : StabilityPoolLiquidationResult;
    transfer_block_index : nat64;
    proportional_refund : opt ThreeUsdReserveRefundReceipt;
    ingress_fee_e8s : nat64;
  };
  ReconciliationRequired : record { reason : text };
